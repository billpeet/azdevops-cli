{
  "name": "@billpeet/azdevops-cli",
  "version": "0.3.0",
  "description": "Azure DevOps CLI tool for AI agent and developer use",
  "author": "billpeet",
  "license": "MIT",
  "bin": {
    "azdevops": "bin/azdevops.js"
  },
  "main": "dist/index.js",
  "files": [
